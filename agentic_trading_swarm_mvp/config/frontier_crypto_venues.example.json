{
  "purpose": "Public market-data registry for frontier crypto venue scanning. Do not put credentials, private/account API URLs, order endpoints, or secrets in this file.",
  "hard_limits": [
    "Public market data only.",
    "No credentials.",
    "No account APIs.",
    "No order APIs.",
    "No live trading."
  ],
  "filters": {
    "quote_assets": ["USD", "USDT", "USDC", "AUD", "EUR", "GBP", "ZAR", "NGN", "GHS", "KES", "IDR", "THB", "SGD", "MYR", "PHP", "TZS", "UGX", "MXN", "BRL", "CLP", "COP", "PEN", "ARS"],
    "exclude_base_assets": ["USD", "USDT", "USDC", "DAI", "TUSD", "FDUSD", "BUSD", "USDP", "PYUSD", "AUD", "EUR", "GBP", "ZAR", "NGN", "GHS", "KES", "IDR", "THB", "SGD", "MYR", "PHP", "TZS", "UGX", "MXN", "BRL", "CLP", "COP", "PEN", "ARS"],
    "top_volume_per_venue": 80,
    "frontier_symbols_per_venue": 40,
    "frontier_max_listing_count": 3,
    "min_frontier_quote_volume_usd": 25000,
    "min_cross_venue_count": 2,
    "regional_fx_normalization_enabled": true,
    "regional_fx_require_fresh_reference": true,
    "regional_fx_max_age_seconds": 300,
    "regional_fx_stale_confidence_haircut": 0.35
  },
  "paper_only_rules": {
    "watchlist_promotion": "two_step_confirm",
    "require_close_above_trigger": true,
    "require_next_interval_hold": true,
    "assumed_position_size": "reduced",
    "require_complete_json": true,
    "regime_entry_gate": {
      "mode": "paper_only",
      "market_key": "okx_basis_mean_reversion",
      "block_new_entries_on_persistent_carry": true,
      "funding_sign_persistence_hours_min": 24,
      "basis_zscore_abs_min": 1.5,
      "basis_percentile_high": 80,
      "basis_percentile_low": 20,
      "reenable_funding_sign_persistence_hours_max": 6,
      "reenable_basis_zscore_abs_max": 0.75,
      "keep_exits_active": true,
      "emit_telemetry": true
    },
    "breakout_quality_filter": {
      "mode": "paper_only",
      "scanner_profile": "breakout_momentum_v2",
      "base_breakout_buffer_pct": 0.2,
      "high_atr_pct_threshold": 4.5,
      "high_vol_breakout_buffer_pct": 0.35,
      "min_rel_volume": 1.8,
      "max_spread_pct": 0.35,
      "require_above_vwap": true,
      "require_above_20ema": true
    },
    "confirmation_proxy": {
      "preferred": "vwap_or_equivalent_intraday_trend",
      "reclaim_after_first_pullback": true,
      "invalidate_on_expanding_sell_volume_loss_of_breakout": true
    },
    "scout_confirmation_gate": {
      "mode": "paper_only",
      "require_higher_timeframe_alignment": true,
      "require_liquidity_confirmation": true,
      "require_spread_within_limit": true,
      "minimum_confidence": 0.67,
      "volatility_guard": "enabled",
      "fallback_action": "hold",
      "downgrade_on_weak_confirmation": true
    }
  },
  "venues": [
